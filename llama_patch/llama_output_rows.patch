-                ggml_backend_tensor_get_async(backend_res, t_logits, logits_out, 0, n_outputs*n_vocab*sizeof(float));
+                const int64_t n_cols = t_logits->ne[0];
+                int64_t row_start = 0, row_count = 0;
+                if (n_cols != n_vocab && llama_output_rows(row_start, row_count) && n_cols == row_count) {
+                    // sliced lm_head: scatter into the full-vocab buffer so samplers and bindings are unchanged
+                    std::vector<float> tmp((size_t) (n_outputs*n_cols));
+                    ggml_backend_tensor_get(t_logits, tmp.data(), 0, tmp.size()*sizeof(float));
+                    std::fill(logits_out, logits_out + (size_t) (n_outputs*n_vocab), -std::numeric_limits<float>::infinity());
+                    for (int64_t i = 0; i < n_outputs; i++) {
+                        std::copy(tmp.begin() + i*n_cols, tmp.begin() + (i + 1)*n_cols, logits_out + i*n_vocab + row_start);
+                    }
+                } else {
+                    ggml_backend_tensor_get_async(backend_res, t_logits, logits_out, 0, n_outputs*n_vocab*sizeof(float));
+                }
