--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -10,6 +10,20 @@
 #include "llama-ext.h"
 
 #include <cinttypes>
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <vector>
+
+// Output-row slicing: LLAMA_OUTPUT_ROWS="start:count" restricts the lm_head to a contiguous range of vocabulary
+// rows (e.g. a TTS model that only ever emits its audio-code tokens). Rows outside the range get -inf logits.
+static inline bool llama_output_rows(int64_t & start, int64_t & count) {
+    start = 0; count = 0;
+    const char * e = getenv("LLAMA_OUTPUT_ROWS");  // read per call so it can be toggled at runtime
+    long long a = 0, b = 0;
+    if (e && sscanf(e, "%lld:%lld", &a, &b) == 2 && a >= 0 && b > 0) { start = a; count = b; }
+    return count > 0;
+}
